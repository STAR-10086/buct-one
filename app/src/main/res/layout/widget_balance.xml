<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/balance_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg_light"
    android:clipToOutline="true"
    android:padding="10dp">

    <TextView
        android:id="@+id/balance_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="校园卡与电费"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/balance_card_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/balance_card_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="校园卡"
                android:textSize="10sp"
                android:textColor="#6E6E73"
                android:maxLines="1" />

            <TextView
                android:id="@+id/balance_card_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未同步"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/balance_ele_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:id="@+id/balance_ele_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="宿舍电费"
                android:textSize="10sp"
                android:textColor="#6E6E73"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/balance_ele_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未同步"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
